<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Modern Clock</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: radial-gradient(ellipse at 20% 20%, #1a1a3e 0%, #0a0a1a 50%, #000 100%);
    font-family: 'Rajdhani', sans-serif;
    overflow: hidden;
    position: relative;
  }

  /* Animated background orbs */
  body::before, body::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    animation: float 12s ease-in-out infinite;
  }
  body::before {
    width: 400px; height: 400px;
    background: #667eea;
    top: -100px; left: -100px;
  }
  body::after {
    width: 350px; height: 350px;
    background: #f093fb;
    bottom: -100px; right: -100px;
    animation-delay: -6s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(60px, 40px) scale(1.15); }
  }

  .container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 45px;
    padding: 40px;
  }

  /* ===== ANALOG CLOCK ===== */
  .analog {
    position: relative;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #23234a 0%, #0d0d20 70%);
    box-shadow:
      0 0 60px rgba(102, 126, 234, 0.25),
      0 0 120px rgba(102, 126, 234, 0.1),
      inset 0 0 60px rgba(0, 0, 0, 0.7),
      inset 0 2px 4px rgba(255, 255, 255, 0.08),
      0 25px 70px rgba(0, 0, 0, 0.7);
    border: 2px solid rgba(102, 126, 234, 0.25);
  }

  /* Rotating conic glow ring */
  .analog::before {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #667eea, #764ba2, #f093fb, #667eea);
    z-index: -1;
    filter: blur(10px);
    opacity: 0.45;
    animation: spin 8s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .ticks { position: absolute; inset: 0; }

  .tick {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2px;
    height: 10px;
    background: rgba(255, 255, 255, 0.35);
    border-radius: 1px;
    transform-origin: center 150px;
  }

  .tick.major {
    width: 4px;
    height: 18px;
    background: linear-gradient(to bottom, #a8b5ff, #667eea);
    box-shadow: 0 0 8px rgba(102, 126, 234, 0.9);
  }

  /* Numerals */
  .numeral {
    position: absolute;
    color: rgba(255, 255, 255, 0.85);
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    font-size: 20px;
    transform: translate(-50%, -50%);
    text-shadow: 0 0 10px rgba(102, 126, 234, 0.6);
    letter-spacing: 0;
  }

  .hand {
    position: absolute;
    left: 50%;
    bottom: 50%;
    transform-origin: 50% 100%;
    border-radius: 10px;
    will-change: transform;
  }

  .hour-hand {
    width: 6px;
    height: 78px;
    margin-left: -3px;
    background: linear-gradient(to top, #667eea, #b3c0ff);
    box-shadow: 0 0 14px rgba(102, 126, 234, 0.9), 0 0 3px rgba(255,255,255,0.8);
    z-index: 3;
  }

  .minute-hand {
    width: 4px;
    height: 105px;
    margin-left: -2px;
    background: linear-gradient(to top, #f093fb, #ffc8f9);
    box-shadow: 0 0 14px rgba(240, 147, 251, 0.9), 0 0 3px rgba(255,255,255,0.8);
    z-index: 2;
  }

  .second-hand {
    width: 2px;
    height: 120px;
    margin-left: -1px;
    background: linear-gradient(to top, #ff5e7e, #ff9eb5);
    box-shadow: 0 0 10px rgba(255, 94, 126, 0.9), 0 0 2px rgba(255,255,255,0.9);
    z-index: 4;
  }

  .second-hand::after {
    content: '';
    position: absolute;
    bottom: -26px;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 28px;
    background: #ff5e7e;
    border-radius: 2px;
    box-shadow: 0 0 8px rgba(255, 94, 126, 0.9);
  }

  .center-cap {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, #667eea 60%, #3a3a7a);
    box-shadow: 0 0 20px rgba(102, 126, 234, 1), 0 0 45px rgba(102, 126, 234, 0.6);
    z-index: 5;
  }

  /* ===== DIGITAL CLOCK ===== */
  .digital {
    padding: 26px 55px;
    background: rgba(20, 20, 45, 0.55);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 0 60px rgba(102, 126, 234, 0.12);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .digital::before {
    content: '';
    position: absolute;
    top: 0; left: -120%;
    width: 60%; height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,0.08), transparent);
    animation: shine 4s ease-in-out infinite;
  }

  @keyframes shine { to { left: 140%; } }

  .time {
    font-family: 'Orbitron', monospace;
    font-size: 58px;
    font-weight: 800;
    letter-spacing: 3px;
    color: #fff;
    font-variant-numeric: tabular-nums;
    text-shadow:
      0 0 18px rgba(102, 126, 234, 0.9),
      0 0 40px rgba(102, 126, 234, 0.45);
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
  }

  .time .blink { animation: blink 1s steps(1) infinite; color: #f093fb; }
  @keyframes blink { 50% { opacity: 0.25; } }

  .time .sec {
    font-size: 32px;
    color: #f093fb;
    font-weight: 600;
    text-shadow: 0 0 15px rgba(240, 147, 251, 0.9);
    min-width: 48px;
    display: inline-block;
  }

  .ampm {
    display: inline-block;
    margin-top: 6px;
    padding: 4px 18px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 30px;
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #fff;
    box-shadow: 0 4px 18px rgba(102, 126, 234, 0.5);
  }

  .date {
    margin-top: 12px;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 1.5px;
    color: rgba(200, 205, 255, 0.75);
  }

  @media (max-width: 480px) {
    .container { gap: 32px; padding: 24px; }
    .analog { width: 230px; height: 230px; }
    .tick { transform-origin: center 115px; }
    .hour-hand { height: 60px; }
    .minute-hand { height: 80px; }
    .second-hand { height: 92px; }
    .numeral { font-size: 16px; }
    .time { font-size: 40px; letter-spacing: 2px; }
    .time .sec { font-size: 22px; min-width: 34px; }
    .digital { padding: 20px 30px; }
    .date { font-size: 14px; }
  }

  @media (max-width: 360px) {
    .analog { width: 190px; height: 190px; }
    .tick { transform-origin: center 95px; }
    .hour-hand { height: 48px; }
    .minute-hand { height: 64px; }
    .second-hand { height: 74px; }
    .time { font-size: 32px; }
    .time .sec { font-size: 18px; min-width: 28px; }
  }
</style>
</head>
<body>

<div class="container">
  <!-- Analog -->
  <div class="analog" id="analog">
    <div class="ticks" id="ticks"></div>
    <div class="hand hour-hand" id="hourHand"></div>
    <div class="hand minute-hand" id="minuteHand"></div>
    <div class="hand second-hand" id="secondHand"></div>
    <div class="center-cap"></div>
  </div>

  <!-- Digital -->
  <div class="digital">
    <div class="time">
      <span id="hh">00</span><span class="blink">:</span><span id="mm">00</span><span class="blink">:</span><span class="sec" id="ss">00</span>
    </div>
    <div class="ampm" id="ampm">AM</div>
    <div class="date" id="date">—</div>
  </div>
</div>

<script>
  // ===== Build tick marks & numerals =====
  const ticksEl = document.getElementById('ticks');
  const analogEl = document.getElementById('analog');

  function buildClockFace() {
    // clear (in case of resize rebuild)
    ticksEl.innerHTML = '';
    analogEl.querySelectorAll('.numeral').forEach(n => n.remove());

    const size = analogEl.clientWidth;
    const radiusTicks = size / 2 - 18;   // distance from center to tick center
    const radiusNums  = size / 2 - 48;   // numerals a bit inward

    for (let i = 0; i < 60; i++) {
      const angle = i * 6; // degrees
      const isMajor = i % 5 === 0;

      const tick = document.createElement('div');
      tick.className = 'tick' + (isMajor ? ' major' : '');
      // position tick at center then rotate outward
      // We'll use transform on each tick individually with translate
      const rad = (angle - 90) * Math.PI / 180;
      const cx = size / 2;
      const cy = size / 2;
      const x = cx + radiusTicks * Math.cos(rad);
      const y = cy + radiusTicks * Math.sin(rad);

      tick.style.left = (x - 1) + 'px';
      tick.style.top  = (y - 5) + 'px';
      tick.style.transformOrigin = 'center center';
      tick.style.transform = `rotate(${angle + 90}deg)`;
      ticksEl.appendChild(tick);
    }

    // numerals 12, 3, 6, 9
    const nums = [
      { n: '12', a: 0 },
      { n: '3',  a: 90 },
      { n: '6',  a: 180 },
      { n: '9',  a: 270 }
    ];

    nums.forEach(({ n, a }) => {
      const rad = (a - 90) * Math.PI / 180;
      const x = size / 2 + radiusNums * Math.cos(rad);
      const y = size / 2 + radiusNums * Math.sin(rad);
      const el = document.createElement('div');
      el.className = 'numeral';
      el.textContent = n;
      el.style.left = x + 'px';
      el.style.top  = y + 'px';
      analogEl.appendChild(el);
    });
  }

  buildClockFace();
  // Rebuild on resize so layout stays correct
  window.addEventListener('resize', () => { buildClockFace(); });

  // ===== Clock hands + digital =====
  const hourHand   = document.getElementById('hourHand');
  const minuteHand = document.getElementById('minuteHand');
  const secondHand = document.getElementById('secondHand');

  const hhEl = document.getElementById('hh');
  const mmEl = document.getElementById('mm');
  const ssEl = document.getElementById('ss');
  const ampmEl = document.getElementById('ampm');
  const dateEl = document.getElementById('date');

  const pad = n => String(n).padStart(2, '0');

  const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];

  function tickClock() {
    const now = new Date();
    const h24 = now.getHours();
    const m = now.getMinutes();
    const s = now.getSeconds();
    const ms = now.getMilliseconds();

    // Smooth angles
    const secAngle  = (s + ms / 1000) * 6;
    const minAngle  = (m + s / 60) * 6;
    const hourAngle = ((h24 % 12) + m / 60 + s / 3600) * 30;

    secondHand.style.transform = `rotate(${secAngle}deg)`;
    minuteHand.style.transform = `rotate(${minAngle}deg)`;
    hourHand.style.transform   = `rotate(${hourAngle}deg)`;

    // Digital
    const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
    hhEl.textContent = pad(h12);
    mmEl.textContent = pad(m);
    ssEl.textContent = pad(s);
    ampmEl.textContent = h24 < 12 ? 'AM' : 'PM';

    // Date
    dateEl.textContent = `${days[now.getDay()]}, ${months[now.getMonth()]} ${now.getDate()}, ${now.getFullYear()}`;

    requestAnimationFrame(tickClock);
  }

  requestAnimationFrame(tickClock);
</script>
</body>
</html>
